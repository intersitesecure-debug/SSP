<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    PDBها را داخل DLL embed می‌کند تا در publish single-file خروجی
    SSP.Server.exe به‌صورت تک‌فایل واقعی باشد (بدون SSP.Core.pdb).
    در Debug build، .NET SDK این را به full override می‌کند.
  -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
