<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Executable so the assembly carries the entry point used by
      ClockRollbackStateTests.FileLease_IsExclusiveAcrossProcesses: the test
      starts a real second process with `dotnet exec <this assembly>`, which
      acquires the production cross-process lease through the public
      ILicenseTimeStateLock seam. `dotnet exec` needs the runtimeconfig.json
      that only an Exe emits, and the probe must start without the adapter
      discovery/test enumeration of a second `dotnet vstest` host (which is
      what used to push the test past its Fact timeout). VSTest still
      discovers and runs the tests in this assembly normally.
    -->
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SSP.Core\SSP.Core.csproj" />
    <ProjectReference Include="..\..\src\SSP.Client\SSP.Client.csproj" />
    <ProjectReference Include="..\..\src\SSP.Server\SSP.Server.csproj" />
    <ProjectReference Include="..\..\src\SSP.Activation\SSP.Activation.csproj" />
    <!-- Authority tooling is never shipped; tests exercise it in-process with ephemeral keys. -->
    <ProjectReference Include="..\..\tools\SSP.LicenseAuthority\SSP.LicenseAuthority.csproj" />
    <!-- The standalone service host: the tests verify its mode gate, and
         referencing it guarantees the host project builds in the solution
         test run even though nothing embeds its publish output here. -->
    <ProjectReference Include="..\..\src\SSP.ServiceHost\SSP.ServiceHost.csproj" />
  </ItemGroup>

</Project>
