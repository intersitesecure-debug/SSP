<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Executable so the assembly carries the entry point used by
      ClockRollbackStateTests.FileLease_IsExclusiveAcrossProcesses: the test
      starts a real second process by launching this project's apphost (or
      by running this assembly with `dotnet exec`), which acquires the production
      cross-process lease through the public ILicenseTimeStateLock seam.
      OutputType=Exe emits both the apphost and the runtimeconfig.json
      `dotnet exec` needs. The probe must start without the adapter
      discovery/test enumeration of a second `dotnet vstest` host, and must
      not reuse DOTNET_HOST_PATH when that variable points at testhost
      (both of those used to push the test past its Fact timeout). VSTest
      still discovers and runs the tests in this assembly normally.
    -->
    <OutputType>Exe</OutputType>

    <!--
      Microsoft.NET.Test.Sdk injects its own entry point into every C# test
      project (obj/Debug/net8.0/SSP.Tests.Program.cs ->
      `AutoGeneratedProgram.Main`). In a library that generated Main is inert,
      but the moment OutputType is Exe the compiler sees two candidates and
      fails the build:

        tests\SSP.Tests\Activation\ClockLockProbe.cs(35,25): error CS0017:
            Program has more than one entry point defined.

      GenerateProgramFile=false is the SDK's supported switch for "this test
      project brings its own Main", so ClockLockProbe.Main stays the single
      entry point. StartupObject then pins it by name: it documents the
      contract and keeps the build unambiguous even if some future package
      contributes another Main. Neither property affects test discovery -
      VSTest loads the assembly through testhost and never calls the entry
      point; only the child process started as this apphost (or `dotnet exec`)
      does.
    -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>SSP.Tests.Activation.ClockLockProbe</StartupObject>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SSP.Core\SSP.Core.csproj" />
    <ProjectReference Include="..\..\src\SSP.Client\SSP.Client.csproj" />
    <ProjectReference Include="..\..\src\SSP.Server\SSP.Server.csproj" />
    <ProjectReference Include="..\..\src\SSP.Activation\SSP.Activation.csproj" />
    <!-- Authority tooling is never shipped; tests exercise it in-process with ephemeral keys. -->
    <ProjectReference Include="..\..\tools\SSP.LicenseAuthority\SSP.LicenseAuthority.csproj" />
    <!-- The standalone service host: the tests verify its mode gate, and
         referencing it guarantees the host project builds in the solution
         test run even though nothing embeds its publish output here. -->
    <ProjectReference Include="..\..\src\SSP.ServiceHost\SSP.ServiceHost.csproj" />
  </ItemGroup>

</Project>
