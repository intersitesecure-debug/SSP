<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SSP Licensing Authority tooling. This project is INTERNAL-ONLY:

      * it is not referenced by any shipped SSP runtime project (the server,
        the standalone service host, the client, the service builder or the
        shared core library)
      * it is not added to any publish target or customer package
      * it ships no key material (no embedded resources, no compiled-in keys)
      * the authority PRIVATE key is supplied by the operator on every
        invocation as a file that lives OUTSIDE the SSP repository

    Dependencies: the SSP.Activation library plus the BCL, and nothing else.
    No third-party command-line parsing package, no shared runtime library -
    so the tool cannot accidentally pull DPAPI, the client template, or any
    shipped runtime into the authority process.

    The isolation is machine-checked, not just documented:
    LicenseAuthoritySecurityIsolationTests reads this file and fails the build
    if it ever grows a package reference or a reference to one of the shipped
    projects. Keep this comment free of those literal names for the same
    reason - it is part of the file the test scans.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>SSP.LicenseAuthority</AssemblyName>
    <RootNamespace>SSP.LicenseAuthority</RootNamespace>
    <IsPackable>false</IsPackable>
    <DebugType>embedded</DebugType>
    <NuGetAudit>false</NuGetAudit>
    <Description>Offline SSP Licensing Authority tooling. Never shipped with customer SSP binaries. Holds no key material of its own.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SSP.Activation\SSP.Activation.csproj" />
  </ItemGroup>

</Project>
